# PHP-Fehler aktivieren (in Produktion deaktivieren)
php_flag display_errors on
php_value error_reporting E_ALL

# Zugriff auf .db Dateien verhindern
<FilesMatch "\.(db)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Verzeichnisauflistung deaktivieren
Options -Indexes

# Nur bestimmte HTTP-Methoden erlauben
<LimitExcept GET POST PUT DELETE OPTIONS>
    Order Allow,Deny
    Deny from all
</LimitExcept>